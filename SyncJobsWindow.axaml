<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DirOpusReImagined.SyncJobsWindow"
        Width="820" Height="520" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Saved Sync Jobs">
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
        <Style Selector="Label">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
            <Setter Property="Padding" Value="0,6,0,2" />
        </Style>
    </Window.Styles>
    <Grid Margin="12" RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="A sync job remembers two folders and how to bring them in line, so a backup is one click (or one line in the command palette). A daily job also runs by itself at its time while DORI is open, and when DORI next opens if that time was missed. Jobs run in the File Operations window like any copy." />
        <Grid Grid.Row="1" ColumnDefinitions="240,12,*">
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <Button x:Name="NewButton" Content="New from Panels" ToolTip.Tip="A job from the active panel's folder to the other panel's" />
                    <Button x:Name="DeleteButton" Content="Delete" />
                </StackPanel>
                <ListBox x:Name="JobList" Background="{DynamicResource GridBackgroundBrush}" />
            </DockPanel>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Editor" Spacing="2">
                    <Label Content="Name" />
                    <TextBox x:Name="NameBox" />
                    <Label Content="From" />
                    <TextBox x:Name="FromBox" Watermark="/home/you/Projects   or   cloud://remote/backup" />
                    <Label Content="To" />
                    <TextBox x:Name="ToBox" />
                    <Label Content="How" />
                    <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="One way: copy what's new, newer or changed" />
                        <ComboBoxItem Content="Mirror: one way, and remove what isn't in From (to the trash)" />
                        <ComboBoxItem Content="Two-way: newer wins, both ways, nothing removed" />
                    </ComboBox>
                    <CheckBox x:Name="ContentBox" Content="Compare contents (checksums), not just size and date" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <CheckBox x:Name="DailyBox" Content="Run every day at" />
                        <TextBox x:Name="TimeBox" Width="80" Watermark="02:00" />
                    </StackPanel>
                    <TextBlock x:Name="LastRunText" Opacity="0.75" Margin="0,6,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button x:Name="SaveButton" Content="Save Job" />
                        <Button x:Name="RunButton" Content="Run Now" />
                    </StackPanel>
                    <TextBlock x:Name="ProblemText" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>

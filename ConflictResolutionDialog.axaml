<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="520"
        x:Class="DirOpusReImagined.ConflictResolutionDialog"
        Width="640" Height="520" MinWidth="480" MinHeight="320"
        Title="Some items already exist"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14" RowDefinitions="Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" x:Name="HeaderText" TextWrapping="Wrap" FontSize="14"
                   Text="Some items already exist at the destination. Choose what to do with each."/>

        <!-- Bulk actions -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,10,0,8">
            <TextBlock Text="Apply to all:" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}"/>
            <Button x:Name="AllOverwriteBtn" Content="Overwrite all" Click="AllOverwrite_Click"/>
            <Button x:Name="AllSkipBtn" Content="Skip all" Click="AllSkip_Click"/>
            <Button x:Name="AllKeepBothBtn" Content="Keep both (all)" Click="AllKeepBoth_Click"/>
        </StackPanel>

        <!-- One card per conflicting item -->
        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RowsPanel" Spacing="8"/>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,12,0,0">
            <Button x:Name="ApplyBtn" Content="Apply" Click="Apply_Click" IsDefault="True"/>
            <Button x:Name="CancelBtn" Content="Cancel" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>

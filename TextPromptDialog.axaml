<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DirOpusReImagined.TextPromptDialog"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="DORI">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Foreground="{DynamicResource GridCellTextBrush}" />
        <TextBox x:Name="InputBox" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="OkButton" Content="OK" IsDefault="True" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="640"
        x:Class="DirOpusReImagined.ConfigHelp"
        Height="640" Width="800" MinHeight="320" WindowStartupLocation="CenterOwner"
        Title="Configuration Help">
        
    <DockPanel LastChildFill="True">

        <!-- Dismiss bar pinned to the bottom, always visible regardless of scroll.
             Mirrors GeneralHelp. Without it this window had no dismiss control at all,
             which on a tiling compositor leaves nothing to click. IsDefault/IsCancel also
             make Enter and Escape close it. -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#40808080" Padding="10">
            <Button Name="OkButton" Content="OK" Click="OkButton_Click"
                    HorizontalAlignment="Right" MinWidth="90" Padding="14,4"
                    FontWeight="Bold" IsDefault="True" IsCancel="True" />
        </Border>

            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="Rundown of the various ARGUMENT parameters that can be used on Buttons" FontSize="20" FontWeight="Bold" Margin="10"/>
                    <TextBlock Text="The following commands can be used in the COMMAND TO RUN field of a button:" FontSize="20" Margin="10"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%BUTTONCONFIG%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will bring up the Add Edit buttons interface of DORI" FontWeight="16"></TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%DRIVEINFO%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will bring up the VOLUME Information Dialog" FontWeight="16"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%RCLONEDIAG%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will bring up the Rclone Diagnostics dialog" FontWeight="16"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%RCLONECONFIG%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will bring up the Rclone remote configuration dialog" FontWeight="16"></TextBlock>
                    </StackPanel>
                
                    <TextBlock Text="The following commands can be used in the ARGUMENTS field of a button:" FontSize="20" Margin="10"/>
                
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%FD%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will inject the path to the first selected folder in the Left panel or the right panel. Left panel first" FontWeight="16"></TextBlock>
                    </StackPanel>
                
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%AF%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will inject every file selected in the Left panel, or the Right if none, space separated, in one command" FontWeight="16"></TextBlock>
                    </StackPanel>
                
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%LAF%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will inject the files selected in the Left panel, or the Right if none - the command runs once per file" FontWeight="16"></TextBlock>
                    </StackPanel>
                
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%LF1%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will inject the path to the first selected file in the Left panel" FontWeight="16"></TextBlock>
                    </StackPanel>
                
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%RF1%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will inject the path to the first selected file in the Right panel" FontWeight="16"></TextBlock>
                    </StackPanel>
                
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%LPAF%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will inject the files selected in the Left panel - the command runs once per file" FontWeight="16"></TextBlock>
                    </StackPanel>
                
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%RPAF%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will inject the files selected in the Right panel - the command runs once per file" FontWeight="16"></TextBlock>
                    </StackPanel>
                
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%LPATH%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will inject the PATH currently selected in the Left panel" FontWeight="16"></TextBlock>
                    </StackPanel>
                
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%RPATH%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will inject the PATH currently selected in the Right panel" FontWeight="16"></TextBlock>
                    </StackPanel>

                    <TextBlock Text="Active-panel parameters" FontSize="20" FontWeight="Bold" Margin="10,20,10,4"/>
                    <TextBlock TextWrapping="Wrap" Margin="10,0,10,10"
                               Text="These resolve against whichever panel you last clicked in - the SOURCE - and the other one - the TARGET. Unlike the Left/Right parameters above, several of these may be used in the same button, so one button works in both directions instead of needing a separate Left-to-Right and Right-to-Left copy. Example: rsync -av %SAF% %TPATH%"/>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%SPATH%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will inject the PATH shown in the SOURCE (active) panel" FontWeight="16"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%TPATH%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will inject the PATH shown in the TARGET (other) panel" FontWeight="16"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%SF1%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will inject the path to the first selected file in the SOURCE panel" FontWeight="16"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%TF1%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will inject the path to the first selected file in the TARGET panel" FontWeight="16"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%SAF%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will inject every file selected in the SOURCE panel, space separated, in one command" FontWeight="16"></TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="    -"></TextBlock>
                        <TextBlock Text="%TAF%" FontWeight="Bold" FontSize="16"></TextBlock>
                        <TextBlock Text="  Will inject every file selected in the TARGET panel, space separated, in one command" FontWeight="16"></TextBlock>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
    </DockPanel>
     
</Window>

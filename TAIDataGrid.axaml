<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="812" d:DesignHeight="312"
             x:Class="DirOpusReImagined.TaiDataGrid">
	<StackPanel>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="12"/>
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="12"/>
			</Grid.ColumnDefinitions>
			<Canvas Name="TheCanvas" 
					Background="{DynamicResource GridBackgroundBrush}" 
					Width="800" Height="300"
					Grid.Row="0"
					Grid.Column="0"
					ClipToBounds="true">
				<Canvas.ContextMenu>
					<ContextMenu Name="GridContextMenu">
						<MenuItem Name="ViewFileMenuItem" Header="View" Click="ViewFile_Click"/>
						<MenuItem Name="CopyToClipboardMenuItem" Header="Copy" InputGesture="Ctrl+C" Click="CopyToClipboard_Click"/>
						<MenuItem Name="CutToClipboardMenuItem" Header="Cut" InputGesture="Ctrl+X" Click="CutToClipboard_Click"/>
						<MenuItem Name="PasteFromClipboardMenuItem" Header="Paste" InputGesture="Ctrl+V" Click="PasteFromClipboard_Click"/>
						<Separator/>
						<MenuItem Name="CalcFolderSizeMenuItem" Header="Calculate Folder Sizes (selected)" InputGesture="Ctrl+Shift+S" Click="FolderSizes_Click"/>
						<MenuItem Name="CalcAllFolderSizesMenuItem" Header="Calculate All Folder Sizes" Click="CalculateAllSizes_Click"/>
						<MenuItem Name="PermissionsMenuItem" Header="File Permissions" Click="Permissions_Click"/>
						<MenuItem Name="SetAttributesMenuItem" Header="Set Dates &amp; Permissions…" Click="SetAttributes_Click"/>
						<MenuItem Name="ChecksumsMenuItem" Header="Checksums…" Click="Checksums_Click"/>
						<MenuItem Name="CompareFilesMenuItem" Header="Compare Files…" Click="CompareFiles_Click"/>
						<MenuItem Name="FlatViewMenuItem" Header="Flat View (all files below)" Click="FlatView_Click"/>
						<MenuItem Name="FindDuplicatesMenuItem" Header="Find Duplicates…" Click="FindDuplicates_Click"/>
						<MenuItem Name="DiskUsageMenuItem" Header="Disk Usage…" Click="DiskUsage_Click"/>
						<MenuItem Name="LabelMenuItem" Header="Label">
							<MenuItem Header="Red" Tag="Red" Click="LabelColour_Click"/>
							<MenuItem Header="Orange" Tag="Orange" Click="LabelColour_Click"/>
							<MenuItem Header="Yellow" Tag="Yellow" Click="LabelColour_Click"/>
							<MenuItem Header="Green" Tag="Green" Click="LabelColour_Click"/>
							<MenuItem Header="Blue" Tag="Blue" Click="LabelColour_Click"/>
							<MenuItem Header="Purple" Tag="Purple" Click="LabelColour_Click"/>
							<MenuItem Header="Grey" Tag="Grey" Click="LabelColour_Click"/>
							<MenuItem Header="No Colour" Tag="None" Click="LabelColour_Click"/>
							<Separator/>
							<MenuItem Header="Tags…" Click="EditLabels_Click"/>
						</MenuItem>
						<MenuItem Name="FileToolsMenuItem" Header="File Tools">
							<MenuItem Name="ImageToolsMenuItem" Header="Image Tools (resize, convert, turn)…" Click="ImageTools_Click"/>
							<MenuItem Name="SplitFileMenuItem" Header="Split File…" Click="SplitFile_Click"/>
							<MenuItem Name="JoinFilesMenuItem" Header="Join Pieces (.001)" Click="JoinFiles_Click"/>
							<Separator/>
							<MenuItem Name="ExportListingMenuItem" Header="Export Listing (CSV, text, HTML)…" Click="ExportListing_Click"/>
							<MenuItem Name="FolderRulesMenuItem" Header="Folder Rules…" Click="FolderRules_Click"/>
							<MenuItem Name="CataloguesMenuItem" Header="Disk Catalogues…" Click="Catalogues_Click"/>
							<Separator/>
							<MenuItem Name="SecureDeleteMenuItem" Header="Securely Delete (overwrite first)…" Click="SecureDelete_Click"/>
						</MenuItem>
						<MenuItem Name="SyncBrowseMenuItem" Header="Synced Browsing" Click="SyncBrowse_Click"/>
						<MenuItem Name="GoToLinkTargetMenuItem" Header="Go to Link Target" Click="GoToLinkTarget_Click"/>
						<MenuItem Name="MakeLinkMenuItem" Header="Make Link in Other Panel" Click="MakeLink_Click"/>
						<Separator/>
						<MenuItem Name="CopyPathMenuItem" Header="Copy Path" Click="CopyPath_Click"/>
						<MenuItem Name="CopyFullPathMenuItem" Header="Copy Full Path" Click="CopyFullPath_Click"/>
						<Separator/>
						<MenuItem Name="TerminalHereMenuItem" Header="Terminal Here" Click="TerminalHere_Click"/>
						<MenuItem Name="RefreshMenuItem" Header="Refresh" InputGesture="Ctrl+R" Click="Refresh_Click"/>
						<MenuItem Name="UndoMenuItem" Header="Undo" InputGesture="Ctrl+Z" IsEnabled="False" Click="Undo_Click"/>
						<Separator/>
						<MenuItem Header="Select by Pattern…" Click="SelectByPattern_Click"/>
						<MenuItem Header="Deselect by Pattern…" Click="DeselectByPattern_Click"/>
						<MenuItem Header="Invert Selection" Click="InvertSelection_Click"/>
						<Separator/>
						<MenuItem Header="Fonts Larger" Click="Option1_Click"/>
						<MenuItem Header="Fonts Smaller" Click="Option2_Click"/>
					</ContextMenu>
				</Canvas.ContextMenu>
			</Canvas>
			<ScrollBar Name="TheVerticleScrollBar" 
					   Orientation="Vertical"
					   AllowAutoHide="False"
					   Grid.Row="0"
					   Grid.Column="1"
					   Minimum="0"
					   Maximum="100"
					   Value="0"
					   ViewportSize="10"
					   Visibility="Visible"
					   Background="{DynamicResource ScrollBarBackgroundBrush}"
					   />
			<ScrollBar Name="TheHorizontalScrollBar"
					   Orientation="Horizontal"
					   AllowAutoHide="False"
					   Grid.Row="1"
					   Grid.Column="0"
					   Minimum="0"
					   Maximum="100"
					   Value="0"
					   ViewportSize="10"
					   Visibility="Visible"
					   Background="{DynamicResource ScrollBarBackgroundBrush}"
					   />
		</Grid>
		<!-- 
		<Canvas Name="TheCanvas" Background="{DynamicResource GridBackgroundBrush}" Width="800" Height="300">
		</Canvas>
		-->

		
	</StackPanel>
</UserControl>

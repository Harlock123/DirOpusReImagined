<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="680"
        x:Class="DirOpusReImagined.AddEditCmdButtonDefinition"
        Title="DORI Settings" Width="900" Height="680" MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Click="Save_OnClick" Margin="5"/>
            <Button Content="Reset Fields" Click="Clear_OnClick" Margin="5" />
            <Button Content="Exit" Click="Exit_OnClick" Margin="5" />
        </StackPanel>
        <TabControl>
        <TabItem Header="Command Buttons">
        <DockPanel>
        <!-- One row per slot, bound to a collection. The 36 slots used to be 36 hand-written
             Buttons here, re-walked by index in three separate loops in the code-behind. -->
        <ListBox DockPanel.Dock="Left" Name="SlotList" Width="210"
                 SelectionMode="Single"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2">
                        <TextBlock Grid.Column="0" Text="{Binding Number}"
                                   Width="26" Opacity="0.55" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="14" Height="14" Margin="0,0,6,0"
                                CornerRadius="2" VerticalAlignment="Center"
                                Background="{Binding Swatch}"
                                BorderBrush="#40808080" BorderThickness="1"
                                IsVisible="{Binding IsConfigured}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                       FontStyle="{Binding LabelStyle}"
                                       Opacity="{Binding LabelOpacity}" />
                            <TextBlock Text="{Binding Detail}" FontSize="10" Opacity="0.6"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding IsConfigured}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- Scrolls rather than clips: the form is taller than it looks, and WindowSizing
             shrinks any window that would not fit its screen, so on a small display or at a
             high UI scale the bottom of this panel (the ToolTip box) used to be cut off with
             no way to reach it. Matches the System Wide Settings tab, which already scrolls. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="4,0,4,8">
                <Label 
                    Padding="4" Content="Button Label" />
            
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="460"
                             Padding="4" Name="tbContent" />
                
                </StackPanel>
            
                <Label 
                    Padding="4" Content="Command To Run"/>
            
                <StackPanel Orientation="Horizontal" Spacing="10">
                
                    <TextBox Width="460"
                        Padding="4" Name="tbCommand" />
                    <Button Name="btnCommandHelp" Content="Show Command Help"  />
                
                </StackPanel>
            
                <Label
                    Padding="4" Content="Arguments"/>
            
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox Width="460"
                        Padding="4" Name="tbArguments" />
                    <Button Name="btnArgHelp" Content="Show Argument Help"  />
                
                </StackPanel>
            
            
            
            
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel>
                        <Label Padding="4" Content="Foreground Color"></Label>
                        <ComboBox Name="cbFOREGROUND" Width="180"></ComboBox>
                        <Label Padding="4" Content="Background Color"></Label>
                        <ComboBox Name="cbBACKGROUND" Width="180"></ComboBox>
                    </StackPanel>
                    <StackPanel>
                        <Label Padding="4" Content="Horizontal Alignment"></Label>
                        <ComboBox Name="cbHorizontal" Width="180">
                        
                        </ComboBox>
                        <Label Padding="4" Content="Vertical Alignment"></Label>
                        <ComboBox Name="cbVertical" Width="180">
                        
                        </ComboBox>
                    </StackPanel>
                    <Button Name="SampleButton" Content="Sample Button" Width="180" Height="38" />
                </StackPanel>
                <CheckBox 
                    Padding="4" Name="cbShellExecute">Shell Execute</CheckBox>
                <CheckBox 
                    Padding="4" Name="cbShowWindow">Show Window</CheckBox>
                <Label 
                    Padding="4" Content="ToolTip"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="140">
                    <TextBox Name="tbToolTip"
                             Padding="4"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             />
                </ScrollViewer>
            </StackPanel>
        </ScrollViewer>
        </DockPanel>
        </TabItem>
        <TabItem Header="System Wide Settings">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12" Spacing="6" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="Terminal" FontSize="16" FontWeight="Bold" />
                    <TextBlock TextWrapping="Wrap"
                               Text="The command used by &quot;Terminal Here&quot; (the panel right-click menu). Leave the command blank to let the app auto-detect a terminal for the current operating system." />

                    <Label Padding="0,6,0,0" Content="Command" />
                    <TextBox Name="tbTerminalCommand"
                             Watermark="e.g. wt.exe  (Windows),  open  (macOS),  x-terminal-emulator  (Linux)" />

                    <Label Padding="0,6,0,0" Content="Arguments" />
                    <TextBox Name="tbTerminalArgs"
                             Watermark="e.g. -d &quot;%DIR%&quot;" />

                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                               Text="Use %DIR% where the target folder should be substituted. Quote it if the path may contain spaces, e.g. -d &quot;%DIR%&quot;. The folder is also set as the launched process's working directory, so many terminals need no arguments at all." />

                    <TextBlock Text="Cloud (rclone)" FontSize="16" FontWeight="Bold" Margin="0,16,0,0" />
                    <CheckBox Name="cbKeepRcloneWarm" Padding="4"
                              Content="Keep rclone running between launches" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,0"
                               Text="Cloud folders take ~15-20s to load the first time after launch while rclone connects and refreshes its token. When enabled, the rclone background process is left running when you close the app and reused next time, so that delay is paid once instead of every launch. Trade-off: a small rclone process keeps running in the background between launches. Off by default." />

                    <TextBlock Text="File operations" FontSize="16" FontWeight="Bold" Margin="0,16,0,0" />
                    <CheckBox Name="cbVerifyCopies" Padding="4"
                              Content="Verify copies (compare checksums after copying)" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,0"
                               Text="After each file is copied, re-read both copies and compare their checksums; if they differ the operation fails instead of silently reporting success. Applies to local disk and Windows/UNC network-share copies (where the checksums are comparable) — cloud copies are not verified. Trade-off: this roughly doubles the amount of reading, so large or network copies take longer. Off by default." />

                    <TextBlock Text="Display" FontSize="16" FontWeight="Bold" Margin="0,16,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Label Content="UI scale" VerticalAlignment="Center" />
                        <TextBox Name="tbUiScale" Width="90" Watermark="Auto" />
                    </StackPanel>
                    <TextBlock Name="tbUiScaleStatus" FontSize="11" TextWrapping="Wrap"
                               Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,0"
                               Text="Scales the whole interface — text, controls, spacing and window sizes alike. Leave it blank (or set 0) for Auto, which reads the scale from your desktop at startup. Set a number such as 1.5 or 2 to override that, for example when the desktop reports nothing usable or when a fractional scale needs nudging. Takes effect the next time the app starts, because the toolkit fixes the scale factor when it initialises. You can also pass --scale 1.5 on the command line for a one-off." />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        </TabControl>
    </DockPanel>
</Window>

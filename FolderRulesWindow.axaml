<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DirOpusReImagined.FolderRulesWindow"
        Width="860" Height="620" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Folder Rules">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
        <Style Selector="Label">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
            <Setter Property="Padding" Value="0,6,0,2" />
        </Style>
    </Window.Styles>

    <Grid Margin="12" RowDefinitions="Auto,*,Auto,140">
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="A rule looks at the files in one folder (not its subfolders) and moves, copies, trashes or labels the ones that match. A watching rule runs by itself while DORI is open: when files arrive, and once an hour for its age test. Files still being downloaded or written are left until they're finished. Rule moves can't be undone with Undo." />

        <Grid Grid.Row="1" ColumnDefinitions="260,12,*">
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                    <Button x:Name="NewButton" Content="New" />
                    <Button x:Name="DuplicateButton" Content="Copy" ToolTip.Tip="A new rule like this one" />
                    <Button x:Name="DeleteButton" Content="Delete" />
                </StackPanel>
                <ListBox x:Name="RuleList" Background="{DynamicResource GridBackgroundBrush}" />
            </DockPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Editor" Spacing="2">
                    <Label Content="Name" />
                    <TextBox x:Name="NameBox" />

                    <Label Content="Look in this folder" />
                    <DockPanel>
                        <Button x:Name="FolderFromPanelButton" DockPanel.Dock="Right" Content="Use panel's folder" Margin="6,0,0,0" />
                        <TextBox x:Name="FolderBox" Watermark="e.g. /home/you/Downloads" />
                    </DockPanel>

                    <Label Content="For files whose names match" />
                    <TextBox x:Name="MatchBox" Watermark="*.pdf;*.docx   or   invoice   or   tag:work" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                        <TextBlock Text="and last changed more than" VerticalAlignment="Center" />
                        <TextBox x:Name="AgeBox" Width="70" Watermark="0" />
                        <TextBlock Text="days ago (0 or empty: any age)" VerticalAlignment="Center" />
                    </StackPanel>

                    <Label Content="Do this" />
                    <ComboBox x:Name="ActionBox" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Move to folder" />
                        <ComboBoxItem Content="Copy to folder" />
                        <ComboBoxItem Content="Move to the trash" />
                        <ComboBoxItem Content="Set a colour label" />
                        <ComboBoxItem Content="Add a tag" />
                    </ComboBox>

                    <Label x:Name="TargetLabel" Content="Folder" />
                    <DockPanel x:Name="TargetPanel">
                        <Button x:Name="TargetFromPanelButton" DockPanel.Dock="Right" Content="Use other panel's folder" Margin="6,0,0,0" />
                        <TextBox x:Name="TargetBox" />
                    </DockPanel>
                    <ComboBox x:Name="ColourBox" HorizontalAlignment="Stretch" IsVisible="False">
                        <ComboBoxItem Content="Red" />
                        <ComboBoxItem Content="Orange" />
                        <ComboBoxItem Content="Yellow" />
                        <ComboBoxItem Content="Green" />
                        <ComboBoxItem Content="Blue" />
                        <ComboBoxItem Content="Purple" />
                        <ComboBoxItem Content="Grey" />
                    </ComboBox>

                    <CheckBox x:Name="EnabledBox" Content="Rule is on" Margin="0,10,0,0" />
                    <CheckBox x:Name="WatchBox" Content="Watch the folder and run by itself" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                        <Button x:Name="SaveButton" Content="Save Rule" />
                        <Button x:Name="RunButton" Content="Run Now…" ToolTip.Tip="Shows what the rule would do, then does it" />
                    </StackPanel>
                    <TextBlock x:Name="ProblemText" TextWrapping="Wrap" Foreground="#D04040" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="2" Text="What the rules did" FontWeight="Bold" Margin="0,12,0,4" />
        <TextBox Grid.Row="3" x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="monospace" FontSize="12" />
    </Grid>
</Window>

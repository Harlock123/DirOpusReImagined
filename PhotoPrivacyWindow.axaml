<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DirOpusReImagined.PhotoPrivacyWindow"
        Width="760" Height="560" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Remove Photo Details">
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Window.Styles>
    <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" RowSpacing="10">
        <TextBlock x:Name="ScopeText" FontWeight="Bold" />
        <ListBox x:Name="FileList" Grid.Row="1" Background="{DynamicResource GridBackgroundBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="220,*" ToolTip.Tip="{Binding Tip}">
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Details}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Text="Take out" FontWeight="Bold" />
            <RadioButton x:Name="LocationRadio" GroupName="What" Content="Only where they were taken (GPS position); keep the camera and date" IsChecked="True" />
            <RadioButton x:Name="AllRadio" GroupName="What" Content="Every detail: location, camera and serial number, date, software, comments (the way it's turned is kept)" />
        </StackPanel>
        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock Text="Save" FontWeight="Bold" />
            <RadioButton x:Name="CopyRadio" GroupName="Where" Content="As copies beside them (photo_clean.jpg)" IsChecked="True" />
            <RadioButton x:Name="OtherRadio" GroupName="Where" Content="As copies in the other panel's folder (same names)" />
            <RadioButton x:Name="ReplaceRadio" GroupName="Where" Content="In place of the originals" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap"
                   Text="The picture itself is copied byte for byte, so nothing is lost in quality. PNG and WebP files lose all their details either way." />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="StartButton" Content="Remove Details" IsDefault="True" />
            <Button x:Name="CloseButton" Content="Close" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

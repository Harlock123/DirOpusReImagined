<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DirOpusReImagined.SettingsWindow"
        Width="600" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Settings">
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
    </Window.Styles>
    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Where the settings are kept" FontWeight="Bold" FontSize="14" />
        <TextBlock x:Name="WhereText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="PortableButton" Content="Keep Them with the Program (portable)" />
            <Button x:Name="UserButton" Content="Keep Them in My User Folder" />
        </StackPanel>

        <TextBlock Text="Move them to another computer" FontWeight="Bold" FontSize="14" Margin="0,8,0,0" />
        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                   Text="Export saves buttons and banks, shortcuts, layouts, filters, columns, the theme, bookmarks, labels, folder rules and sync jobs in one .zip. Import puts a .zip's settings in place of these (the current ones are backed up first) and starts DORI again." />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ExportButton" Content="Export…" />
            <Button x:Name="ImportButton" Content="Import…" />
            <CheckBox x:Name="CataloguesBox" Content="Include disk catalogues" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="Language" FontWeight="Bold" FontSize="14" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="LanguageBox" Width="200" />
            <TextBlock Text="Menus, buttons and dialogs; DORI starts again to use it everywhere." VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap" MaxWidth="340" />
        </StackPanel>

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontWeight="Bold" />
        <Button x:Name="CloseButton" Content="Close" HorizontalAlignment="Right" IsCancel="True" />
    </StackPanel>
</Window>

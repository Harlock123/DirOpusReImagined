<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DirOpusReImagined.ChecksumWindow"
        Width="760" Height="520" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Checksums">

    <Window.Styles>
        <Style Selector="Grid > TextBlock, StackPanel > TextBlock, DockPanel > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
    </Window.Styles>

    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto,Auto">
        <TextBlock x:Name="HeaderText" Grid.Row="0" FontWeight="Bold" TextTrimming="CharacterEllipsis" Text=""/>

        <!-- Compute mode: algorithm and an expected hash to compare against -->
        <Grid x:Name="ComputeOptions" Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,8,0,0">
            <TextBlock Grid.Column="0" Text="Algorithm" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" x:Name="AlgorithmBox" Width="120" SelectedIndex="2">
                <ComboBoxItem Content="MD5"/>
                <ComboBoxItem Content="SHA-1"/>
                <ComboBoxItem Content="SHA-256"/>
                <ComboBoxItem Content="SHA-512"/>
            </ComboBox>
            <TextBlock Grid.Column="2" Text="Compare with" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <TextBox Grid.Column="3" x:Name="ExpectedBox"
                     Watermark="Paste the hash you were given (any case, with or without spaces)"/>
        </Grid>

        <ListBox x:Name="ResultsList" Grid.Row="2" Margin="0,8,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <SelectableTextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                                 FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,Noto Sans Mono,Liberation Mono,monospace"
                                                 Foreground="{DynamicResource GridCellTextBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,16,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Spacing="4" Margin="0,8,0,0">
            <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" Height="12" IsVisible="False"/>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" Text=""/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="CopyButton" Content="Copy" IsEnabled="False"
                    ToolTip.Tip="Copy the results in checksum-file format"/>
            <Button x:Name="SaveButton" Content="Save checksum file" IsEnabled="False"
                    ToolTip.Tip="Write a file that sha256sum -c (or this window) can verify later"/>
            <Button x:Name="CloseButton" Content="Cancel" MinWidth="80"/>
        </StackPanel>
    </Grid>
</Window>

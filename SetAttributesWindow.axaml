<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DirOpusReImagined.SetAttributesWindow"
        Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Set Dates &amp; Permissions">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="16" Spacing="10">
        <TextBlock x:Name="HeaderText" FontWeight="Bold" TextWrapping="Wrap" />

        <CheckBox x:Name="DateBox" Content="Set the modified date and time to" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0">
            <TextBox x:Name="DateText" Width="200" Watermark="2026-11-15 14:30" />
            <Button x:Name="NowButton" Content="Now" />
        </StackPanel>

        <StackPanel x:Name="UnixPanel" Spacing="6">
            <CheckBox x:Name="ModeBox" Content="Change permissions" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0">
                <TextBox x:Name="ModeText" Width="200" Watermark="755, or u+x,go-w" />
                <TextBlock x:Name="ModePreview" VerticalAlignment="Center" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" />
            </StackPanel>
            <TextBlock Margin="28,0,0,0" FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                       Text="As chmod: octal (644, 755) or who (u, g, o, a) then + - = and r w x. X adds execute only to folders and to files that someone can already run." />
        </StackPanel>

        <StackPanel x:Name="WindowsPanel" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Read-only:" VerticalAlignment="Center" />
            <ComboBox x:Name="ReadOnlyBox" SelectedIndex="0" Width="220">
                <ComboBoxItem Content="Leave as it is" />
                <ComboBoxItem Content="Make read-only" />
                <ComboBoxItem Content="Make writable" />
            </ComboBox>
        </StackPanel>

        <CheckBox x:Name="ContentsBox" Content="Also everything inside the selected folders" />

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="ApplyButton" Content="Apply" IsDefault="True" />
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>

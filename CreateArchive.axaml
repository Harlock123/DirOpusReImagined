<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="300"
        x:Class="DirOpusReImagined.CreateArchive"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Create Archive">

    <Window.Styles>
        <Style Selector="StackPanel > TextBlock, Grid > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="16" Spacing="10">
        <TextBlock Name="SummaryText" Text="Archive the selected items" TextWrapping="Wrap" FontWeight="Bold" />

        <TextBlock Text="Archive name" />
        <TextBox Name="NameBox" Text="Archive.zip" />

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" >
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Format" VerticalAlignment="Center" Margin="0,0,12,6" />
            <ComboBox Grid.Row="0" Grid.Column="1" Name="FormatBox" HorizontalAlignment="Stretch" Margin="0,0,0,6" SelectedIndex="0">
                <ComboBoxItem Content="ZIP (.zip) — opens anywhere" />
                <ComboBoxItem Content="Gzipped tar (.tar.gz) — keeps Unix permissions" />
                <ComboBoxItem Content="Tar (.tar) — no compression" />
                <ComboBoxItem Content="Zstandard tar (.tar.zst) — fast and smaller than .tar.gz" />
                <ComboBoxItem Name="XzItem" Content="xz tar (.tar.xz) — smallest tar (needs xz)" />
                <ComboBoxItem Name="SevenZipItem" Content="7-Zip (.7z) — small, with an optional password (needs 7-Zip)" />
            </ComboBox>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Compression" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox Grid.Row="1" Grid.Column="1" Name="LevelBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem Content="Normal" />
                <ComboBoxItem Content="Smallest (slower)" />
                <ComboBoxItem Content="Fastest (larger)" />
                <ComboBoxItem Content="None (store only)" />
            </ComboBox>
        </Grid>

        <StackPanel Name="PasswordPanel" Spacing="4">
            <CheckBox Name="PasswordCheck" Content="Protect with a password (AES-256)" />
            <Grid ColumnDefinitions="*,8,*" Name="PasswordFields" IsVisible="False">
                <TextBox Grid.Column="0" Name="PasswordBox" PasswordChar="•" Watermark="Password" />
                <TextBox Grid.Column="2" Name="PasswordAgainBox" PasswordChar="•" Watermark="Password again" />
            </Grid>
            <TextBlock Name="PasswordNote" IsVisible="False" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                       Text="The files' contents are encrypted; their names and sizes can still be seen, as in any zip. Opens in 7-Zip, WinZip, Keka, The Unarchiver and DORI (Windows Explorer's built-in zip support can't open it). Nothing can recover a forgotten password." />
        </StackPanel>

        <StackPanel Name="ProgressPanel" Spacing="4" IsVisible="False">
            <ProgressBar Name="Bar" Minimum="0" Maximum="1" Height="18" />
            <TextBlock Name="ProgressText" Text="" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>

        <TextBlock Name="ErrorText" Text="" TextWrapping="Wrap" Foreground="#E0584B" IsVisible="False" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="OkButton" Content="Create" MinWidth="80" FontWeight="Bold" />
            <Button Name="CancelButton" Content="Cancel" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>

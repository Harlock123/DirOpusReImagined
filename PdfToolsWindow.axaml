<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DirOpusReImagined.PdfToolsWindow"
        Width="640" Height="560" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="PDF Tools">
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
    </Window.Styles>
    <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto" RowSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Do" FontWeight="Bold" />
            <ComboBox x:Name="ActionBox" Width="320" SelectedIndex="0">
                <ComboBoxItem Content="Merge them into one PDF" />
                <ComboBoxItem Content="Split into parts" />
                <ComboBoxItem Content="Take out some pages" />
                <ComboBoxItem Content="Turn pages" />
            </ComboBox>
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <ListBox x:Name="FileList" Background="{DynamicResource GridBackgroundBrush}" />
            <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                <Button x:Name="UpButton" Content="▲ Up" />
                <Button x:Name="DownButton" Content="▼ Down" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
            <TextBlock x:Name="PagesLabel" Text="Pages" />
            <TextBox x:Name="PagesBox" Grid.Column="1" Watermark="for example 1-3, 5, 8-  (empty for all)" />
            <TextBlock x:Name="EachLabel" Grid.Row="1" Text="Pages in each part" />
            <TextBox x:Name="EachBox" Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="1" />
            <TextBlock x:Name="TurnLabel" Grid.Row="2" Text="Turn" />
            <ComboBox x:Name="TurnBox" Grid.Row="2" Grid.Column="1" Width="180" SelectedIndex="0">
                <ComboBoxItem Content="90° right" />
                <ComboBoxItem Content="180°" />
                <ComboBoxItem Content="90° left" />
            </ComboBox>
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="130,*" RowDefinitions="Auto,Auto" RowSpacing="8">
            <TextBlock x:Name="NameLabel" Text="New file" />
            <TextBox x:Name="NameBox" Grid.Column="1" />
            <TextBlock Grid.Row="1" Text="Save into" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <RadioButton x:Name="SameFolderRadio" GroupName="Where" Content="The same folder" IsChecked="True" />
                <RadioButton x:Name="OtherPanelRadio" GroupName="Where" Content="The other panel's folder" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="4" TextWrapping="Wrap"
                   Text="New files are made; the originals are never changed. Pages are copied as they are, without losing quality." />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="StartButton" Content="Make It" IsDefault="True" />
            <Button x:Name="CloseButton" Content="Close" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

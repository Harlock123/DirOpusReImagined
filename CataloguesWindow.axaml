<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DirOpusReImagined.CataloguesWindow"
        Width="980" Height="660" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Disk Catalogues">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Window.Styles>

    <Grid Margin="12" RowDefinitions="Auto,*,Auto,Auto">
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="A catalogue is a saved list of everything under a folder: an external drive, a network share or a cloud remote. Browse and search it while the drive isn't connected, and press Update when it is, to see what changed since last time." />

        <Grid Grid.Row="1" ColumnDefinitions="250,12,*">
            <DockPanel Grid.Column="0">
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button x:Name="NewButton" Content="New from Panel…" Margin="0,0,6,6"
                            ToolTip.Tip="Catalogue the folder the panel shows, and everything below it" />
                    <Button x:Name="UpdateButton" Content="Update" Margin="0,0,6,6"
                            ToolTip.Tip="Look at the drive again and show what changed" />
                    <Button x:Name="DeleteButton" Content="Delete" Margin="0,0,6,6" />
                </WrapPanel>
                <ListBox x:Name="CatalogueList" Background="{DynamicResource GridBackgroundBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="Search All" Margin="6,0,0,0" />
                    <TextBox x:Name="SearchBox" Watermark="Find in every catalogue: *.mp4;holiday" />
                </DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button x:Name="UpButton" DockPanel.Dock="Left" Content="↑ Up" Margin="0,0,8,0" />
                    <TextBlock x:Name="PathText" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="PathSegmentEllipsis" />
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button x:Name="ShowButton" DockPanel.Dock="Right" Content="Show in Panel"
                            ToolTip.Tip="Go to this item in the panel, when its drive is connected" />
                    <TextBlock x:Name="InfoText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                </DockPanel>
                <ListBox x:Name="EntryList" Background="{DynamicResource GridBackgroundBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,100,150" ToolTip.Tip="{Binding Tip}">
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="{Binding Weight}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                <TextBlock Grid.Column="2" Text="{Binding DateText}" Opacity="0.75" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <TextBox Grid.Row="2" x:Name="ReportBox" IsVisible="False" IsReadOnly="True" AcceptsReturn="True"
                 Height="170" Margin="0,10,0,0" FontFamily="monospace" FontSize="12" TextWrapping="NoWrap" />

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" IsVisible="False" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DirOpusReImagined.SimilarPhotosWindow"
        Width="900" Height="660" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Find Similar Photos">
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Window.Styles>
    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*,Auto">
        <TextBlock x:Name="ScopeText" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
            <TextBlock Text="How alike" VerticalAlignment="Center" />
            <ComboBox x:Name="ThresholdBox" SelectedIndex="1" Width="230">
                <ComboBoxItem Content="Nearly identical (strict)" />
                <ComboBoxItem Content="Look alike (normal)" />
                <ComboBoxItem Content="Roughly alike (loose)" />
            </ComboBox>
            <CheckBox x:Name="SubfoldersBox" Content="Include subfolders" IsChecked="True" />
            <Button x:Name="FindButton" Content="Find" IsDefault="True" />
            <Button x:Name="StopButton" Content="Stop" IsVisible="False" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,8" TextWrapping="Wrap"
                   Text="Finds resized copies, re-saved JPEGs and burst shots. In each group the best (most pixels, then largest file) comes first and is never marked." />
        <ListBox x:Name="ResultsList" Grid.Row="3" Background="{DynamicResource GridBackgroundBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,1" ToolTip.Tip="{Binding Tip}">
                        <CheckBox IsVisible="{Binding IsPhoto}" IsChecked="{Binding IsMarked, Mode=TwoWay}" Margin="16,0,6,0" VerticalAlignment="Center" />
                        <Image Grid.Column="1" Source="{Binding Thumb}" Width="64" Height="48" Stretch="Uniform" IsVisible="{Binding IsPhoto}" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2" Text="{Binding Text}" FontWeight="{Binding Weight}" VerticalAlignment="Center" TextTrimming="PathSegmentEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding Detail}" Opacity="0.7" Margin="12,0,4,0" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="MarkButton" Content="Mark All but the Best" IsEnabled="False" />
                <Button x:Name="ClearButton" Content="Clear Marks" IsEnabled="False" />
                <Button x:Name="ShowButton" Content="Show in Panel" IsEnabled="False" />
                <Button x:Name="TrashButton" Content="Move Marked to Trash…" IsEnabled="False" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="2" Content="Close" IsCancel="True" />
        </Grid>
    </Grid>
</Window>

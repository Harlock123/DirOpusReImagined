<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="600"
        xmlns:sc="clr-namespace:SyntaxColorizer.Controls;assembly=SyntaxColorizer"
        x:Class="DirOpusReImagined.FileViewer"
        Width="820" Height="600" WindowStartupLocation="CenterOwner"
        Title="View">

    <DockPanel LastChildFill="True">

        <!-- Top bar: file name, mode toggle, wrap toggle -->
        <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="10,6">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Name="InfoText" Grid.Column="0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" FontWeight="Bold" />
                <Button Name="PrevButton" Grid.Column="1" Content="&#x25C0;" MinWidth="34" Margin="8,0,2,0" IsVisible="False"
                        ToolTip.Tip="Previous file in the panel (Left, or Alt+Left)" Click="PrevButton_Click" />
                <TextBlock Name="PositionText" Grid.Column="2" VerticalAlignment="Center" Margin="4,0" IsVisible="False"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Button Name="NextButton" Grid.Column="3" Content="&#x25B6;" MinWidth="34" Margin="2,0,8,0" IsVisible="False"
                        ToolTip.Tip="Next file in the panel (Right, or Alt+Right)" Click="NextButton_Click" />
                <Button Name="SlideshowButton" Grid.Column="4" Content="Slideshow" Margin="0,0,8,0" IsVisible="False"
                        ToolTip.Tip="The panel's pictures full screen, one after another (F5)" Click="SlideshowButton_Click" />
                <CheckBox Name="WrapCheck" Grid.Column="5" Content="Wrap" VerticalAlignment="Center"
                          Margin="8,0" IsChecked="False" IsCheckedChanged="WrapCheck_Changed" />
                <Button Name="ModeButton" Grid.Column="6" Content="Hex" MinWidth="70"
                        FontWeight="Bold" Click="ModeButton_Click" />
                <Button Name="HexEditorButton" Grid.Column="7" Content="Hex Editor" Margin="8,0,0,0" IsVisible="False"
                        ToolTip.Tip="Open the whole file in the hex editor (go to, find bytes, change bytes)" Click="HexEditorButton_Click" />
                <Button Name="EditButton" Grid.Column="8" Content="Edit" MinWidth="70" Margin="8,0,0,0" IsVisible="False"
                        ToolTip.Tip="Change this text file here (Ctrl/Cmd+S saves)" Click="EditButton_Click" />
                <Button Name="SaveButton" Grid.Column="9" Content="Save" MinWidth="70" Margin="8,0,0,0" IsVisible="False"
                        FontWeight="Bold" Click="SaveButton_Click" />
            </Grid>
        </Border>

        <!-- Dismiss bar -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="10,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Button Name="DismissButton" Grid.Column="1" Content="Dismiss" MinWidth="90"
                        FontWeight="Bold" Click="DismissButton_Click" />
            </Grid>
        </Border>

        <!-- A photo's EXIF details (camera, exposure, date taken, place), under the image. -->
        <Border Name="PhotoBar" DockPanel.Dock="Bottom" IsVisible="False" Padding="10,6"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}">
            <SelectableTextBlock Name="PhotoText" TextWrapping="Wrap" FontSize="12" />
        </Border>

        <!-- Content: exactly one of these is visible, chosen by the preview result's shape. -->
        <Panel>
            <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <TextBox Name="ContentBox" IsReadOnly="True" AcceptsReturn="True"
                         BorderThickness="0" FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                         TextWrapping="NoWrap" Padding="8" />
            </ScrollViewer>

            <!-- StretchDirection=DownOnly so a small image shows at native size instead of being
                 blown up to fill the window. -->
            <Image Name="PreviewImage" IsVisible="False" Margin="8"
                   Stretch="Uniform" StretchDirection="DownOnly" />

            <!-- Syntax-highlighted text, used in place of the plain TextBox when the file is a
                 recognised source file and small enough to tokenise cheaply. -->
            <sc:SyntaxHighlightingTextBox Name="SyntaxBox" IsVisible="False"
                                          IsReadOnly="True" ShowLineNumbers="True"
                                          FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
        </Panel>
    </DockPanel>
</Window>

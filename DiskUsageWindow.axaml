<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DirOpusReImagined.DiskUsageWindow"
        Width="820" Height="600" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Disk Usage">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Window.Styles>

    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto">
        <DockPanel Grid.Row="0">
            <Button x:Name="UpButton" DockPanel.Dock="Left" Content="↑ Up" Margin="0,0,8,0" IsEnabled="False"
                    ToolTip.Tip="Back to the folder above (Backspace)" />
            <TextBlock x:Name="PathText" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="PathSegmentEllipsis" />
        </DockPanel>

        <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,8,0,8" TextWrapping="Wrap" Text="Measuring…" />

        <ListBox x:Name="UsageList" Grid.Row="2" Background="{DynamicResource GridBackgroundBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="2*,3*,90,60,110" ToolTip.Tip="{Binding Tip}">
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="{Binding Weight}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Percent}"
                                     Height="10" MinHeight="10" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding PercentText}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.75" />
                        <TextBlock Grid.Column="4" Text="{Binding FilesText}" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.75" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" IsCancel="True" Margin="8,0,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="OpenButton" Content="Open Folder" IsEnabled="False"
                        ToolTip.Tip="Look inside the selected folder (double-click or Enter does the same)" />
                <Button x:Name="RevealButton" Content="Show in Panel" IsEnabled="False"
                        ToolTip.Tip="Go to the selected item in the panel this was opened from" />
                <Button x:Name="RescanButton" Content="Measure Again" />
                <Button x:Name="StopButton" Content="Stop" IsVisible="False" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

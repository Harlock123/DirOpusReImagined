<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="440"
        x:Class="DirOpusReImagined.OperationsWindow"
        Width="540" Height="440" MinWidth="380" MinHeight="240"
        Title="File Operations"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12" RowDefinitions="Auto,*,Auto">

        <!-- Header: summary + bulk actions -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Column="0" Grid.Row="0" x:Name="SummaryText" VerticalAlignment="Center"
                       FontSize="15" FontWeight="SemiBold" Text="No operations" TextWrapping="Wrap"/>
            <WrapPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="PauseAllBtn" Content="Pause all" Margin="0,0,8,4" Click="PauseAllBtn_Click"
                        ToolTip.Tip="Pause everything that hasn't finished; press again to resume"/>
                <Button x:Name="RetryAllBtn" Content="Retry all" Margin="0,0,8,4" Click="RetryAllBtn_Click"
                        ToolTip.Tip="Retry every failed or cancelled operation — only the items that didn't finish"/>
                <Button x:Name="ClearBtn" Content="Clear finished" Margin="0,0,8,4" Click="ClearBtn_Click"/>
                <Button x:Name="CancelAllBtn" Content="Cancel all" Margin="0,0,0,4" Click="CancelAllBtn_Click"/>
            </WrapPanel>
        </Grid>

        <!-- Per-operation cards -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="OpsPanel" Spacing="8"/>
        </ScrollViewer>

        <!-- Empty-state hint -->
        <TextBlock Grid.Row="2" x:Name="EmptyHint" Margin="0,10,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   Text="Copy, move and delete operations appear here while they run."/>
    </Grid>
</Window>

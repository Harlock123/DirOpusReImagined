<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DirOpusReImagined.ReplaceWindow"
        Width="900" Height="640" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Find and Replace in Files">

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBox CheckBox">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Window.Styles>

    <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock x:Name="ScopeText" Grid.Row="0" FontWeight="Bold" TextTrimming="CharacterEllipsis" />

        <Grid Grid.Row="1" ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6" Margin="0,10,0,0">
            <TextBlock Grid.Row="0" Text="Find" VerticalAlignment="Center" />
            <TextBox x:Name="FindBox" Grid.Row="0" Grid.Column="1" />
            <TextBlock Grid.Row="1" Text="Replace with" VerticalAlignment="Center" />
            <TextBox x:Name="ReplaceBox" Grid.Row="1" Grid.Column="1" Watermark="(empty removes what was found)" />
            <TextBlock Grid.Row="2" Text="Files named" VerticalAlignment="Center" />
            <TextBox x:Name="NamesBox" Grid.Row="2" Grid.Column="1" Watermark="all files, or for example *.txt;*.md" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16" Margin="0,8,0,0">
            <CheckBox x:Name="MatchCaseBox" Content="Match case" />
            <CheckBox x:Name="WholeWordBox" Content="Whole words" />
            <CheckBox x:Name="RegexBox" Content="Regular expression ($1 in the replacement)" />
            <CheckBox x:Name="SubfoldersBox" Content="Include subfolders" IsChecked="True" />
            <Button x:Name="PreviewButton" Content="Preview" IsDefault="True" />
            <Button x:Name="StopButton" Content="Stop" IsVisible="False" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,8" TextWrapping="Wrap"
                   Text="Preview shows every change before anything is written. Only the files you leave ticked are changed, and Undo (Ctrl/Cmd+Z) puts them back." />

        <ListBox x:Name="ResultsList" Grid.Row="4" Background="{DynamicResource GridBackgroundBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1" ToolTip.Tip="{Binding Tip}">
                        <CheckBox Grid.Column="0" IsVisible="{Binding IsFile}" IsChecked="{Binding IsMarked, Mode=TwoWay}"
                                  Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontWeight="{Binding Weight}" FontFamily="{Binding Font}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Opacity="0.7" Margin="12,0,4,0" VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button x:Name="ReplaceButton" Content="Replace in Ticked Files" IsEnabled="False" />
            <Button x:Name="CloseButton" Content="Close" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>

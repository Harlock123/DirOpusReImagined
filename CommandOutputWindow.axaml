<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DirOpusReImagined.CommandOutputWindow"
        Width="760" Height="420" MinWidth="380" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Command Output">
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <Button x:Name="StopButton" Content="Stop" IsEnabled="False" />
                <Button x:Name="ClearButton" Content="Clear" />
                <Button x:Name="CloseButton" Content="Close" />
            </StackPanel>
            <TextBlock x:Name="StateText" VerticalAlignment="Center" Foreground="{DynamicResource GridCellTextBrush}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBox x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace" FontSize="12" />
    </DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DirOpusReImagined.PreviousVersionsWindow"
        Width="860" Height="520" MinWidth="520" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Title="Previous Versions">
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GridCellTextBrush}" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Window.Styles>
    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto,Auto">
        <TextBlock x:Name="PathText" FontWeight="Bold" TextTrimming="PathSegmentEllipsis" />
        <Grid Grid.Row="1" ColumnDefinitions="170,110,*,110,150" Margin="8,10,8,4" Opacity="0.75">
            <TextBlock Text="Taken" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Text="By" FontWeight="Bold" />
            <TextBlock Grid.Column="2" Text="Snapshot" FontWeight="Bold" />
            <TextBlock Grid.Column="3" Text="Size" FontWeight="Bold" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Text="Changed" FontWeight="Bold" Margin="12,0,0,0" />
        </Grid>
        <ListBox x:Name="VersionList" Grid.Row="2" Background="{DynamicResource GridBackgroundBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="170,110,*,110,150" ToolTip.Tip="{Binding Tip}">
                        <TextBlock Text="{Binding When}" />
                        <TextBlock Grid.Column="1" Text="{Binding Source}" Opacity="0.8" />
                        <TextBlock Grid.Column="2" Text="{Binding Label}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="{Binding Changed}" Margin="12,0,0,0" Opacity="0.8" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap" />
        <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ViewButton" Content="View" IsEnabled="False" />
                <Button x:Name="CompareButton" Content="Compare with Now" IsEnabled="False" />
                <Button x:Name="ShowButton" Content="Show in Panel" IsEnabled="False" />
                <Button x:Name="CopyButton" Content="Restore a Copy" IsEnabled="False"
                        ToolTip.Tip="Copies the old version beside the current one, named with its date" />
                <Button x:Name="RestoreButton" Content="Restore…" IsEnabled="False"
                        ToolTip.Tip="Puts the old version in place of the current one, which goes to the trash" />
            </StackPanel>
            <Button x:Name="CloseButton" Grid.Column="2" Content="Close" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
